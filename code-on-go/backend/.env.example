# Server
PORT=8080
NODE_ENV=development

# Firebase Admin — path to service account JSON (or use ADC on Cloud Run)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=your-project-id

# Local dev: skip Firebase and use in-memory store
USE_IN_MEMORY_STORE=true

# Git workspaces root (cloned repos live here on the server)
GIT_WORKSPACES_DIR=./.workspaces

# Optional: encrypt user secrets at rest (32-byte hex key)
SECRETS_ENCRYPTION_KEY=

# CORS — comma-separated origins (Expo dev, production app)
CORS_ORIGINS=*

# Cursor Cloud Agents API (Cloud Run secret is often named cursorapi)
cursorapi=
# CURSOR_API_KEY=
