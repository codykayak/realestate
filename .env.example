# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app → Config

# ── EmailJS (for form submissions → cody@macrorei.com) ──────────────────────
# Get free account at https://emailjs.com → Service ID, Template ID, Public Key
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# ── Firebase ─────────────────────────────────────────────────────────────────
// For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyAuYn4nm9jTIcdFeNStmLF_Ky8qgwe4R2M",
  authDomain: "property-managment-a5ed3.firebaseapp.com",
  projectId: "property-managment-a5ed3",
  storageBucket: "property-managment-a5ed3.firebasestorage.app",
  messagingSenderId: "742597343666",
  appId: "1:742597343666:web:d04e9435b5fdaafa048cab",
  measurementId: "G-4L5MKHVJSJ"
};

// Initialize Firebase
const app = initializeApp(firebaseConfig);
const analytics = getAnalytics(app);

# ── Firebase Cloud Functions (Twilio SMS) ────────────────────────────────────
# Region must match deployed functions (default us-central1)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# ── Property Management module (ManyDoors AI) — white-label + isolated Firebase ────
# All optional. With no values set, the module runs at /property-management on a
# local (browser) store with ManyDoors AI branding. Override per deployment to
# white-label and to point at a SEPARATE Firebase project (keeps PM data fully
# isolated from the host site's data).
VITE_PM_PRODUCT_NAME=ManyDoors AI
VITE_PM_PRODUCT_TAGLINE=AI-powered property operations — maintenance, leasing, and resident communications
VITE_PM_COMPANY_NAME=ManyDoors AI
VITE_PM_LOGO=
VITE_PM_HERO_IMAGE=/Template/manydoors-ai-hero.png
VITE_PM_ACCENT=#1a9e96
VITE_PM_ACCENT_SOFT=rgba(26, 158, 150, 0.14)
VITE_PM_FUTURE_SITE=manydoorsai.com
VITE_PM_BASE_PATH=/property-management
VITE_PM_DEFAULT_TENANT=demo
VITE_PM_SUPPORT_EMAIL=cody@macrorei.com

# Separate Firebase project for the PM module (public web config — safe to commit).
# Leave blank to run on the local store only.
VITE_PM_FIREBASE_API_KEY=
VITE_PM_FIREBASE_AUTH_DOMAIN=
VITE_PM_FIREBASE_PROJECT_ID=
VITE_PM_FIREBASE_STORAGE_BUCKET=
VITE_PM_FIREBASE_MESSAGING_SENDER_ID=
VITE_PM_FIREBASE_APP_ID=

# Cloud Firestore database NAME for the PM module. This project uses a NAMED
# database called "property-managment" (note the spelling — it must match the
# name shown in the Firebase console exactly). Set to (default) or leave blank
# only if you used the default database instead of a named one.
VITE_PM_FIRESTORE_DB=property-managment
