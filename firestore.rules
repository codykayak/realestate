rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    function isOrgOwner(orgId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/orgs/$(orgId)).data.ownerUid == request.auth.uid;
    }

    match /users/{userId}/data/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Old Tartar Research — per-user research data
    match /users/{userId}/tartarResearch/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/tartarResearch/mentions/{mentionId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/tartarResearch/entities/{entityId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/tartarResearch/sources/{sourceId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/tartarResearch/searchTerms/{termId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/tartarResearch/ingestionJobs/{jobId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }
    match /users/{userId}/tartarResearch/anomalies/{anomalyId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/tartarResearch/usageLog/{logId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }
    // API keys — server (Admin SDK / Cloud Functions) only
    match /users/{userId}/tartarResearch/apiSecrets/{provider} {
      allow read, write: if false;
    }

    // Platform catalog (read-only for signed-in users)
    match /tartarPlatform/{collection}/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /users/{userId}/callLogs/{logId} {
      allow read, create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }
    match /users/{userId}/smsLogs/{logId} {
      allow read, create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if false;
    }
    match /users/{userId}/scheduledSms/{docId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Shared lead pool for multiple agents on one spreadsheet
    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOrgOwner(orgId);
      allow delete: if isOrgOwner(orgId);
    }
    match /orgs/{orgId}/members/{memberId} {
      allow read: if isOrgMember(orgId);
      allow create: if isSignedIn() && (
        memberId == request.auth.uid
        || isOrgOwner(orgId)
      );
      allow delete: if isSignedIn() && (
        memberId == request.auth.uid
        || isOrgOwner(orgId)
      );
      allow update: if isOrgOwner(orgId);
    }
    match /orgs/{orgId}/data/{docId} {
      allow read, write: if isOrgMember(orgId);
    }

    // Public seller deal tracker (read-only for sellers via magic link)
    match /sellerPortals/{token} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
